.next
next-env.d.ts
*.tsbuildinfo
.env*
docs/BRIEF.md
.logs/
supabase/.temp
supabase/.branches
.qodo/
coverage
.DS_Store
*.pem
npm-debug.log*
/test-results/
/playwright-report/
